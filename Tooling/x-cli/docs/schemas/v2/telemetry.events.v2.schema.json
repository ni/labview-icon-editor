{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labview-community-ci-cd.github.io/x-cli/schemas/v2/telemetry.events.v2.schema.json",
  "title": "Telemetry Event (v2)",
  "type": "object",
  "additionalProperties": true,
  "required": ["step", "status"],
  "properties": {
    "step": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "start": { "type": "integer", "minimum": 0 },
    "end": { "type": "integer", "minimum": 0 },
    "stage": { "type": ["string", "null"], "minLength": 1 },
    "task": { "type": ["string", "null"], "minLength": 1 },
    "runner": { "type": ["string", "null"], "minLength": 1 },
    "bitness": { "type": ["string", "null"], "enum": ["32", "64", "both", null] },
    "lv_version": { "type": ["string", "null"], "minLength": 1 },
    "producer": { "type": ["string", "null"], "minLength": 1 },
    "artifacts": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    },
    "error": { "type": ["string", "null"], "minLength": 1 },
    "meta": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "git": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": ["string", "null"], "minLength": 1 },
        "branch": { "type": ["string", "null"], "minLength": 1 },
        "dirty": { "type": ["boolean", "null"] }
      }
    }
  }
}
