{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequirementsCatalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "section", "text", "type", "priority", "verification", "acceptance"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9]+-\\d{3}[A-Z]?$"
      },
      "section": { "type": "string", "minLength": 1 },
      "text": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "minLength": 1 },
      "priority": { "type": "string", "minLength": 1 },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["methods", "primary"],
        "properties": {
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "primary": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "level": { "type": "string" }
        }
      },
      "acceptance": { "type": "string", "minLength": 1 },
      "owner": { "type": "string" },
      "phase": { "type": "string" },
      "status": { "type": "string" },
      "trace": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "upstream": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "downstream": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "evidence": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "risk": { "type": "string" },
      "constraints": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "notes": { "type": "string" },
      "rationale": { "type": "string" },
      "version": { "type": "string" },
      "acceptanceCriteria": { "type": "string" },
      "verificationDetail": { "type": "string" },
      "verificationLevel": { "type": "string" }
    }
  }
}
