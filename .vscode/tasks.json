{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "buildMode",
      "type": "pickString",
      "description": "Artifact type: VIP + lvlibp builds, or single-arch VIP only",
      "options": [
        "vip+lvlibp",
        "vip-single"
      ],
      "default": "vip+lvlibp"
    },
    {
      "id": "devModeBitness",
      "type": "pickString",
      "description": "Target LabVIEW bitness for dev-mode tasks",
      "options": [
        "32",
        "64"
      ],
      "default": "64"
    },
    {
      "id": "lvlibpBitness",
      "type": "pickString",
      "description": "Bitness for VIP build task",
      "options": [
        "both",
        "32",
        "64"
      ],
      "default": "64"
    },
    {
      "id": "semverMajor",
      "type": "promptString",
      "description": "Major version",
      "default": "0"
    },
    {
      "id": "semverMinor",
      "type": "promptString",
      "description": "Minor version",
      "default": "1"
    },
    {
      "id": "semverPatch",
      "type": "promptString",
      "description": "Patch version",
      "default": "0"
    },
    {
      "id": "buildNumber",
      "type": "promptString",
      "description": "Build number",
      "default": "1"
    },
    {
      "id": "companyName",
      "type": "promptString",
      "description": "Company name for Build.ps1",
      "default": "LabVIEW-Community-CI-CD"
    },
    {
      "id": "authorName",
      "type": "promptString",
      "description": "Author name for Build.ps1",
      "default": "Local Developer"
    },
    {
      "id": "devmodePhrase",
      "type": "promptString",
      "description": "Dev-mode intent phrase (e.g., /devmode bind 2021 both force)",
      "default": "/devmode bind 2021 both force"
    },
    {
      "id": "devmodeForcePhrase",
      "type": "promptString",
      "description": "Dev-mode intent phrase for force overwrite",
      "default": "/devmode bind 2021 both force"
    }
  ],
  "tasks": [
    {
      "label": "Analyze VI Package (Pester)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/analyze-vi-package/run-local.ps1",
        "-VipArtifactPath",
        "${workspaceFolder}/builds/VI Package/",
        "-MinLabVIEW",
        "21.0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build/Package VIP (simulate)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/build-vip/build_vip.ps1",
        "-SupportedBitness",
        "64",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-VIPBPath",
        "Tooling/deployment/labview-icon-editor.vipb",
        "-Package_LabVIEW_Version",
        "2021",
        "-LabVIEWMinorRevision",
        "3",
        "-Major",
        "0",
        "-Minor",
        "0",
        "-Patch",
        "0",
        "-Build",
        "0",
        "-Commit",
        "manual",
        "-ReleaseNotesFile",
        "Tooling/deployment/release_notes.md",
        "-DisplayInformationJSON",
        "'{}'",
        "-Simulate",
        "-SkipPPLCheck"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build (isolated worktree)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/worktree-build.ps1",
        "-SourceRepoPath",
        "${workspaceFolder}",
        "-Ref",
        "HEAD",
        "-SupportedBitness",
        "${input:devModeBitness}",
        "-LvlibpBitness",
        "${input:lvlibpBitness}",
        "-Major",
        "${input:semverMajor}",
        "-Minor",
        "${input:semverMinor}",
        "-Patch",
        "${input:semverPatch}",
        "-Build",
        "${input:buildNumber}",
        "-CompanyName",
        "${input:companyName}",
        "-AuthorName",
        "${input:authorName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build PPL (simulate)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-build-lvlibp-task.ps1",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-SupportedBitness",
        "64",
        "-Major",
        "0",
        "-Minor",
        "0",
        "-Patch",
        "0",
        "-Build",
        "0",
        "-Commit",
        "manual"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build/Package VIP",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "& { & \"${workspaceFolder}/scripts/run-build-or-package.ps1\" -BuildMode \"${input:buildMode}\" -WorkspacePath \"${workspaceFolder}\" -LabVIEWMinorRevision 3 -LvlibpBitness \"${input:lvlibpBitness}\" }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build release asset (VI Package x64)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/task-build-vip.ps1",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Bitness",
        "64"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GH_TOKEN": "${env:GH_TOKEN}",
          "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build pipeline (full simulate)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/run-build-or-package.ps1",
        "-BuildMode",
        "vip+lvlibp",
        "-WorkspacePath",
        "${workspaceFolder}",
        "-LabVIEWMinorRevision",
        "3",
        "-LvlibpBitness",
        "both",
        "-Simulate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build release asset (VI Package x86)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/task-build-vip.ps1",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Bitness",
        "32"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GH_TOKEN": "${env:GH_TOKEN}",
          "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build release asset (VI Package 32 & 64 bits)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/task-build-vip.ps1",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Bitness",
        "both",
        "-SkipCIGate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Draft release",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "& { $runId = & \"${workspaceFolder}/scripts/check-ci-gate.ps1\" -WorkflowFile \".github/workflows/ci.yml\" -RepositoryPath \"${workspaceFolder}\" -Quiet -ReturnRunId; if ($LASTEXITCODE -ne 0 -or -not $runId) { exit $LASTEXITCODE }; gh workflow run draft-release.yml -f run_id=$runId }"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GH_TOKEN": "${env:GH_TOKEN}",
          "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build release asset (Packed Project Library, x64)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "& \"${workspaceFolder}/scripts/run-build-lvlibp-task.ps1\" -RepositoryPath \"${workspaceFolder}\" -SupportedBitness \"64\" -Major 0 -Minor 0 -Patch 0 -Build 0 -Commit \"manual\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build release asset (Packed Project Library, x86)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "& \"${workspaceFolder}/scripts/run-build-lvlibp-task.ps1\" -RepositoryPath \"${workspaceFolder}\" -SupportedBitness \"32\" -Major 0 -Minor 0 -Patch 0 -Build 0 -Commit \"manual\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Set Dev Mode (LabVIEW)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/set-development-mode/run-dev-mode.ps1",
        "-SupportedBitness",
        "${input:devModeBitness}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Bind Dev Mode (default bind both)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/bind-development-mode/BindDevelopmentMode.ps1",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Mode",
        "bind",
        "-Bitness",
        "both"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Mode (interactive bind/unbind)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/bind-development-mode/RunInteractiveBind.ps1",
        "-RepositoryPath",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Guided PowerShell helper for bind/unbind",
      "group": "Dev Mode",
      "presentation": {
        "reveal": "always"
      },
      "isBackground": false
    },
    {
      "label": "Dev Mode (bind both with Force)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/bind-development-mode/BindDevelopmentMode.ps1",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Mode",
        "bind",
        "-Bitness",
        "both",
        "-Force"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Mode Bind (check + run)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/tools/DevModeAgentCli/DevModeAgentCli.csproj",
        "--",
        "--phrase",
        "${input:devmodePhrase}",
        "--repo",
        "${workspaceFolder}",
        "--summary",
        "${workspaceFolder}/reports/dev-mode-bind.json",
        "--execute"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Intent CLI (plan+execute) for dev-mode bind; safe default",
      "group": "Dev Mode",
      "presentation": {
        "reveal": "always"
      },
      "isBackground": false
    },
    {
      "label": "Dev Mode Bind (force overwrite)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/tools/DevModeAgentCli/DevModeAgentCli.csproj",
        "--",
        "--phrase",
        "${input:devmodeForcePhrase}",
        "--repo",
        "${workspaceFolder}",
        "--summary",
        "${workspaceFolder}/reports/dev-mode-bind.json",
        "--execute"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Intent CLI with Force to overwrite existing dev-mode tokens",
      "group": "Dev Mode",
      "presentation": {
        "reveal": "always"
      },
      "isBackground": false
    },
    {
      "label": "Dev Mode Bind (force clean)",
      "type": "shell",
      "detail": "Unbind with Force then bind with Force for both bitnesses; use when tokens point elsewhere",
      "group": "Dev Mode",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "& { pwsh .github/actions/bind-development-mode/BindDevelopmentMode.ps1 -RepositoryPath '${workspaceFolder}' -Mode unbind -Bitness both -Force; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; pwsh .github/actions/bind-development-mode/BindDevelopmentMode.ps1 -RepositoryPath '${workspaceFolder}' -Mode bind -Bitness both -Force }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [],
      "isBackground": false
    },
    {
      "label": "Revert Dev Mode (LabVIEW)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.github/actions/revert-development-mode/run-dev-mode.ps1",
        "-SupportedBitness",
        "${input:devModeBitness}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Unbind/reset dev mode for the selected bitness",
      "group": "Dev Mode",
      "presentation": {
        "reveal": "always"
      },
      "isBackground": false
    },
    {
      "label": "Requirements",
      "type": "shell",
      "command": "python",
      "args": [
        "dotnet",
        "run",
        "--project",
        "${workspaceFolder}/tools/RequirementsSummarizer/RequirementsSummarizer.csproj",
        "--csv",
        "${workspaceFolder}/docs/requirements/Requirements.csv",
        "--rows",
        "5",
        "--title",
        "Requirements Checklist",
        "--repo",
        "${env:GITHUB_REPOSITORY}",
        "--section-details",
        "--summary-output",
        "${workspaceFolder}/reports/req-summary.md",
        "--full-output",
        "${workspaceFolder}/reports/req-full.md",
        "--json-output",
        "${workspaceFolder}/reports/requirements.json",
        "--html-output",
        "${workspaceFolder}/reports/requirements.html"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test VIPM Docker",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/Tooling/docker/vipm/test-vipm.ps1",
        "-RepositoryRoot",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "VIPM Docker Smoke",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/Tooling/docker/vipm/smoke-vipm.ps1",
        "-RepositoryRoot",
        "${workspaceFolder}",
        "-VipcPath",
        "icon-editor-developer.vipc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}