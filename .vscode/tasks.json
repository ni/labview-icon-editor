{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "devModeBitness",
      "type": "pickString",
      "description": "Target LabVIEW bitness for dev-mode tasks",
      "options": [
        "32",
        "64"
      ],
      "default": "64"
    },
    {
      "id": "devmodePhrase",
      "type": "promptString",
      "description": "Dev-mode intent phrase (e.g., /devmode bind 2021 both force)",
      "default": "/devmode bind 2021 both force"
    },
    {
      "id": "devmodeForcePhrase",
      "type": "promptString",
      "description": "Dev-mode intent phrase for force overwrite",
      "default": "/devmode bind 2021 both force"
    },
    {
      "id": "vipbPath",
      "type": "promptString",
      "description": "Path to the VIPB used by dev-mode (relative to repo root)"
    }
  ],
  "tasks": [
    {
      "label": "Build LVAddon (VI Package)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/ie.ps1",
        "-Command",
        "build-worktree",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Ref",
        "HEAD",
        "-SupportedBitness",
        "64",
        "-LvlibpBitness",
        "both",
        "-Major",
        "0",
        "-Minor",
        "1",
        "-Patch",
        "0",
        "-Build",
        "1",
        "-CompanyName",
        "LabVIEW-Community-CI-CD",
        "-AuthorName",
        "Local Developer"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
