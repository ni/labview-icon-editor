{
  "version": "2.0.0",
  "inputs": [],
  "tasks": [
    {
      "label": "Build LVAddon (VI Package)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/ie.ps1",
        "-Command",
        "build-worktree",
        "-RepositoryPath",
        "${workspaceFolder}",
        "-Ref",
        "HEAD",
        "-SupportedBitness",
        "64",
        "-LvlibpBitness",
        "both",
        "-Major",
        "0",
        "-Minor",
        "1",
        "-Patch",
        "0",
        "-Build",
        "1",
        "-CompanyName",
        "LabVIEW-Community-CI-CD",
        "-AuthorName",
        "Local Developer"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
